# Vortex Application - Environment Variables Template
# Copy this file to .env and fill with your actual values
# Never commit .env to version control

# === JWT Security Configuration ===
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# === Database Configuration - Main Application Service ===
# Oracle Database (Production)
ORACLE_DB_URL=jdbc:oracle:thin:@localhost:1521:XE
ORACLE_DB_USERNAME=vortex_user
ORACLE_DB_PASSWORD=secure_oracle_password

# PostgreSQL Database (profile "postgres": cloud, or "dev,postgres" locally)
# The database must exist before the first boot; Flyway creates the schema
VORTEX_DB_URL=jdbc:postgresql://localhost:5432/vortex
VORTEX_DB_USERNAME=vortex
VORTEX_DB_PASSWORD=secure_vortex_db_password

# H2 Database (Development)
H2_DB_URL=jdbc:h2:mem:vortex;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
H2_DB_USERNAME=sa
H2_DB_PASSWORD=

# === Database Configuration - Authorization Service ===
# PostgreSQL Database
POSTGRES_DB_URL=jdbc:postgresql://localhost:5433/vortex_auth
POSTGRES_DB_USERNAME=vortex_auth
POSTGRES_DB_PASSWORD=secure_postgres_password

# === Message Broker Configuration ===
# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=secure_rabbitmq_password

# SQS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/vortex-queue

# === Email Service Configuration ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_AUTH=true
SMTP_STARTTLS=true

# === Redis Configuration ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password

# === CORS Configuration ===
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# === Application Configuration ===
SERVER_PORT=8080
AUTH_SERVER_PORT=8081
MAIN_FRONTEND_PORT=5173
AUTH_FRONTEND_PORT=3001

# === Monitoring & Logging ===
MANAGEMENT_ENDPOINTS_ENABLED=true
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_BR_COM_VORTEX=DEBUG

# === Circuit Breaker Configuration ===
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
CIRCUIT_BREAKER_WAIT_DURATION_OPEN_STATE=30000
CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10