{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test e2e --project=chromium --workers=1",
    "build-only": "vite build",
    "type-check": "node --max-old-space-size=1536 ./node_modules/vue-tsc/bin/vue-tsc.js --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "generate-api": "openapi-generator-cli generate -i ../../docs/application/openapi-backend.json -g typescript-axios -o src/api/generated --skip-validate-spec"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vee-validate/rules": "^4.15.1",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@playwright/test": "^1.65.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
