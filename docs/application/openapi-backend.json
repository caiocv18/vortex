{
  "components": {
    "schemas": {
      "LucroPorProdutoDTO": {
        "description": "DTO para o relatório de lucro por produto",
        "properties": {
          "descricao": {
            "description": "Descrição do produto",
            "example": "Smartphone Samsung Galaxy S21",
            "type": "string"
          },
          "id": {
            "description": "ID do produto",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "lucroTotal": {
            "description": "Lucro total",
            "example": 7500.0,
            "type": "number"
          },
          "totalUnidadesVendidas": {
            "description": "Total de unidades vendidas",
            "example": 15,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "MovimentoEstoque": {
        "description": "Representa um movimento de estoque (entrada ou saída)",
        "properties": {
          "dataMovimento": {
            "description": "Data e hora em que o movimento foi registrado (gerado automaticamente)",
            "example": "2023-01-01T10:00:00",
            "format": "date-time",
            "readOnly": true,
            "type": "string"
          },
          "id": {
            "description": "Identificador único do movimento de estoque (gerado automaticamente)",
            "example": 1,
            "format": "int64",
            "readOnly": true,
            "type": "integer"
          },
          "produtoDescricao": {
            "description": "Descrição do produto associado ao movimento (preenchida pela API; ignorada na criação e na alteração)",
            "example": "Smartphone Samsung Galaxy S21",
            "readOnly": true,
            "type": "string"
          },
          "produtoId": {
            "description": "Identificador do produto associado ao movimento",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "quantidadeMovimentada": {
            "description": "Quantidade de itens movimentados (deve ser maior que zero)",
            "example": 5,
            "exclusiveMinimum": 0,
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "tipoMovimentacao": {
            "description": "Tipo de movimentação (ENTRADA aumenta o estoque, SAIDA diminui o estoque)",
            "enum": [
              "ENTRADA",
              "SAIDA"
            ],
            "example": "ENTRADA",
            "type": "string"
          },
          "valorVenda": {
            "description": "Valor de venda unitário (calculado automaticamente para SAIDA como 1.35 * valorFornecedor, nulo para ENTRADA)",
            "example": 2025.0,
            "readOnly": true,
            "type": "number"
          }
        },
        "required": [
          "produtoId",
          "quantidadeMovimentada",
          "tipoMovimentacao"
        ],
        "title": "Movimento de Estoque",
        "type": "object"
      },
      "PageMetadata": {
        "properties": {
          "number": {
            "format": "int64",
            "type": "integer"
          },
          "size": {
            "format": "int64",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalElements",
          "totalPages"
        ],
        "type": "object"
      },
      "PagedModelMovimentoEstoque": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/MovimentoEstoque"
            },
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageMetadata"
          }
        },
        "required": [
          "content",
          "page"
        ],
        "type": "object"
      },
      "PagedModelProdutoDTO": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/ProdutoDTO"
            },
            "type": "array"
          },
          "page": {
            "$ref": "#/components/schemas/PageMetadata"
          }
        },
        "required": [
          "content",
          "page"
        ],
        "type": "object"
      },
      "ProdutoDTO": {
        "description": "DTO para transferência de dados de Produto",
        "properties": {
          "descricao": {
            "description": "Descrição do produto",
            "example": "Smartphone Samsung Galaxy S21",
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "description": "ID do produto",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "quantidadeEmEstoque": {
            "default": 0,
            "description": "Quantidade em estoque",
            "example": 10,
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tipoProdutoId": {
            "description": "ID do tipo de produto",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "valorFornecedor": {
            "description": "Valor do fornecedor",
            "example": 1500.0,
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "descricao",
          "tipoProdutoId",
          "valorFornecedor"
        ],
        "type": "object"
      },
      "ProdutoPorTipoDTO": {
        "description": "DTO para o relatório de produtos por tipo",
        "properties": {
          "descricao": {
            "description": "Descrição do produto",
            "example": "Smartphone Samsung Galaxy S21",
            "type": "string"
          },
          "id": {
            "description": "ID do produto",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "quantidadeEmEstoque": {
            "description": "Quantidade em estoque",
            "example": 10,
            "format": "int32",
            "type": "integer"
          },
          "totalSaidas": {
            "description": "Quantidade total de saídas",
            "example": 15,
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TipoProdutoDTO": {
        "description": "DTO para transferência de dados de Tipo de Produto",
        "properties": {
          "id": {
            "description": "ID do tipo de produto",
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "nome": {
            "description": "Nome do tipo de produto",
            "example": "Eletrônicos",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "nome"
        ],
        "type": "object"
      }
    }
  },
  "externalDocs": {
    "description": "README do projeto",
    "url": "https://github.com/caiocv18/vortex#readme"
  },
  "info": {
    "contact": {
      "name": "Vortex no GitHub",
      "url": "https://github.com/caiocv18/vortex"
    },
    "description": "API RESTful para gerenciamento completo de estoque, incluindo cadastro de produtos, tipos de produtos, movimentações de entrada e saída, e geração de relatórios. Desenvolvida como TCC da pós-graduação em Desenvolvimento Full-Stack da PUCRS.",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "API de Controle de Estoque - Vortex",
    "version": "0.1.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/movimentos": {
      "get": {
        "description": "Retorna uma página de movimentos no formato {\"content\": [...], \"page\": {\"size\", \"number\", \"totalElements\", \"totalPages\"}}. Sem parâmetros: page=0, size=20, sort=dataMovimento,desc. Um size acima de 100 é atendido com 100. O q filtra pela descrição do produto (contém, sem diferenciar maiúsculas) e o tipo pela movimentação; ausentes, não filtram.",
        "operationId": "findAllMovimentos",
        "parameters": [
          {
            "description": "Trecho da descrição do produto (contém, sem diferenciar maiúsculas)",
            "example": "notebook",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Tipo de movimentação; ausente traz entradas e saídas",
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "enum": [
                "ENTRADA",
                "SAIDA"
              ],
              "type": "string"
            }
          },
          {
            "description": "Zero-based page index (0..N)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The size of the page to be returned",
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": [
                "dataMovimento,DESC"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PagedModelMovimentoEstoque"
                }
              }
            },
            "description": "Operação bem-sucedida"
          },
          "400": {
            "description": "Tipo de movimentação inválido ou ordenação por propriedade inexistente"
          }
        },
        "summary": "Busca os movimentos de estoque, uma página por vez",
        "tags": [
          "Movimentos de Estoque"
        ]
      },
      "post": {
        "description": "Cria um novo movimento de estoque com os dados fornecidos",
        "operationId": "createMovimento",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimentoEstoque"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimentoEstoque"
                }
              }
            },
            "description": "Movimento de estoque criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos fornecidos ou estoque insuficiente"
          },
          "404": {
            "description": "Produto não encontrado"
          }
        },
        "summary": "Cria um novo movimento de estoque",
        "tags": [
          "Movimentos de Estoque"
        ]
      }
    },
    "/movimentos/{id}": {
      "delete": {
        "description": "Exclui um movimento de estoque existente pelo seu ID",
        "operationId": "deleteMovimento",
        "parameters": [
          {
            "description": "ID do movimento de estoque a ser excluído",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Movimento de estoque excluído com sucesso"
          },
          "404": {
            "description": "Movimento de estoque não encontrado"
          }
        },
        "summary": "Exclui um movimento de estoque",
        "tags": [
          "Movimentos de Estoque"
        ]
      },
      "get": {
        "description": "Retorna um movimento de estoque específico pelo seu ID",
        "operationId": "findMovimentoById",
        "parameters": [
          {
            "description": "ID do movimento de estoque a ser buscado",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimentoEstoque"
                }
              }
            },
            "description": "Operação bem-sucedida"
          },
          "404": {
            "description": "Movimento de estoque não encontrado"
          }
        },
        "summary": "Busca um movimento de estoque pelo ID",
        "tags": [
          "Movimentos de Estoque"
        ]
      },
      "put": {
        "description": "Atualiza um movimento de estoque existente com os dados fornecidos",
        "operationId": "updateMovimento",
        "parameters": [
          {
            "description": "ID do movimento de estoque a ser atualizado",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimentoEstoque"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimentoEstoque"
                }
              }
            },
            "description": "Movimento de estoque atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos fornecidos ou estoque insuficiente"
          },
          "404": {
            "description": "Movimento de estoque ou produto não encontrado"
          }
        },
        "summary": "Atualiza um movimento de estoque",
        "tags": [
          "Movimentos de Estoque"
        ]
      }
    },
    "/produtos": {
      "get": {
        "description": "Retorna uma página de produtos no formato {\"content\": [...], \"page\": {\"size\", \"number\", \"totalElements\", \"totalPages\"}}. Sem parâmetros: page=0, size=20, sort=descricao,asc. Um size acima de 100 é atendido com 100. O q filtra pela descrição (contém, sem diferenciar maiúsculas); vazio ou ausente não filtra.",
        "operationId": "findAllProdutos",
        "parameters": [
          {
            "description": "Trecho da descrição do produto (contém, sem diferenciar maiúsculas)",
            "example": "notebook",
