[
  {"name": "event_id", "type": "STRING", "mode": "REQUIRED", "description": "eventId set by the producer; views deduplicate on it"},
  {"name": "event_type", "type": "STRING", "mode": "REQUIRED", "description": "Always MOVIMENTO_ESTOQUE"},
  {"name": "schema_version", "type": "STRING", "mode": "NULLABLE", "description": "version field of the event"},
  {"name": "event_ts", "type": "TIMESTAMP", "mode": "REQUIRED", "description": "When the event was produced, in UTC; partition column"},
  {"name": "user_key", "type": "STRING", "mode": "NULLABLE", "description": "Pseudonym of the user: HMAC-SHA256 of the normalized username, joins with curated_user_events.user_key"},
  {"name": "hmac_key_version", "type": "STRING", "mode": "REQUIRED", "description": "Version of the HMAC key that produced user_key"},
  {"name": "movement_id", "type": "INT64", "mode": "REQUIRED", "description": "movimentoId"},
  {"name": "product_id", "type": "INT64", "mode": "REQUIRED", "description": "produtoId"},
  {"name": "product_description", "type": "STRING", "mode": "NULLABLE", "description": "produtoDescricao"},
  {"name": "movement_type", "type": "STRING", "mode": "REQUIRED", "description": "tipoMovimentacao: ENTRADA or SAIDA"},
  {"name": "quantity", "type": "INT64", "mode": "REQUIRED", "description": "quantidadeMovimentada"},
  {"name": "sale_value", "type": "NUMERIC", "mode": "NULLABLE", "description": "valorVenda (exits)"},
  {"name": "supplier_value", "type": "NUMERIC", "mode": "NULLABLE", "description": "valorFornecedor"},
  {"name": "stock_before", "type": "INT64", "mode": "NULLABLE", "description": "estoqueAnterior"},
  {"name": "stock_after", "type": "INT64", "mode": "NULLABLE", "description": "estoqueAtual"},
  {"name": "movement_ts", "type": "TIMESTAMP", "mode": "NULLABLE", "description": "dataMovimento, in UTC"},
  {"name": "profit", "type": "NUMERIC", "mode": "NULLABLE", "description": "lucro (exits)"},
  {"name": "product_type", "type": "STRING", "mode": "NULLABLE", "description": "tipoProduto"},
  {"name": "source_file", "type": "STRING", "mode": "REQUIRED", "description": "Landing file the line came from"},
  {"name": "run_id", "type": "STRING", "mode": "REQUIRED", "description": "Pipeline run that wrote the row"},
  {"name": "ingested_at", "type": "TIMESTAMP", "mode": "REQUIRED", "description": "Start of that pipeline run, in UTC"}
